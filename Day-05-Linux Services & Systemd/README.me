systemctl --failed

journalctl -u SERVICE
journalctl -u SERVICE -n 50
journalctl -u SERVICE -f

systemctl cat SERVICE
systemctl list-dependencies SERVICE

ss -lntp
nginx -t
curl -I http://localhost
```

